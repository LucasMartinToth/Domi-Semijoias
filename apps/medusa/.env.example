# ---- Medusa (backend de comércio) ----
# Copie para .env e preencha. NUNCA commite valores reais (senhas, tokens).

# Postgres. Dev: Supabase (Session pooler, porta 5432). Prod: Railway.
# Senha com caracteres especiais deve vir URL-encoded (ex.: @ = %40).
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
# "true" para Postgres hospedado que exige SSL (Supabase/Neon/Railway).
DATABASE_SSL=true

# Segredos — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
COOKIE_SECRET=

# CORS — inclua domínio oficial, staging e previews em produção.
STORE_CORS=http://localhost:3000,http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:3000,http://localhost:9000,http://localhost:5173

# Opcional em dev (sem isto, Medusa usa módulos em memória).
# REDIS_URL=redis://localhost:6379

# Mercado Pago — ACCESS TOKEN é SECRETO, só no servidor (nunca no client).
# MEDUSA_MERCADO_PAGO_ACCESS_TOKEN=
